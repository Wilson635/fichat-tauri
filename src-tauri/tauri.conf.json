{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FiChat",
  "version": "1.0.0",
  "identifier": "com.firsttrust.fichat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FiChat",
        "label": "main",
        "width": 1200,
        "height": 750,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "title": "FiChat",
      "tooltip": "FiChat"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
  }
}
